# Address the upload server listens on. Use :8080 to listen on all interfaces.
LISTEN_ADDR=:8080

# Directory where uploaded files are stored.
UPLOAD_DIR=./uploads

# Keep at least this many bytes free by deleting the oldest uploads.
MIN_FREE_BYTES=1073741824

# Maximum total multipart request size in bytes.
MAX_UPLOAD_BYTES=10737418240
